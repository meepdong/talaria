<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15+ draws the app behind the system bars, so their colour is the window's: the app's background,
         with dark icons on it. values-night has the dark version. -->
    <style name="Theme.Talaria" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
