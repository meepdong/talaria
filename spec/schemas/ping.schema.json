{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/ping.schema.json",
  "title": "ping",
  "description": "Either side, every 30 s while idle (request). The answer is a result with the sender's clock.",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "ping"
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "params": {
      "type": "object"
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "id"
  ]
}
