{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/term.screen.schema.json",
  "title": "term.screen",
  "description": "Bridge to the watching device (notification): the session's screen changed (§16).",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "term.screen"
    },
    "params": {
      "type": "object",
      "properties": {
        "grant": {
          "type": "string",
          "pattern": "^tg-[0-9a-f]{32}$"
        },
        "session": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "cols": {
          "type": "integer",
          "minimum": 1
        },
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "cursor_x": {
          "type": "integer",
          "minimum": 0
        },
        "cursor_y": {
          "type": "integer",
          "minimum": 0
        },
        "command": {
          "type": "string",
          "maxLength": 64
        },
        "control": {
          "type": "boolean"
        },
        "text": {
          "type": "string",
          "maxLength": 262144
        },
        "alternate": {
          "type": "boolean"
        }
      },
      "required": [
        "grant",
        "session",
        "cols",
        "rows",
        "cursor_x",
        "cursor_y",
        "text",
        "control"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "params"
  ]
}
