{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/talk.configure.result.schema.json",
  "title": "talk.configure.result",
  "description": "Result of talk.configure (\u00a79): as talk.setup's.",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brain",
        "speech",
        "voice",
        "brains",
        "speeches",
        "voices"
      ],
      "properties": {
        "brain": {
          "type": "string",
          "maxLength": 200
        },
        "speech": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "voice": {
          "type": "string",
          "maxLength": 100
        },
        "brains": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "hears",
              "speaks"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "hears": {
                "type": "boolean"
              },
              "speaks": {
                "type": "boolean"
              }
            }
          }
        },
        "speeches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "voices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "id",
    "result"
  ]
}
