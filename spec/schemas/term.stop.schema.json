{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/term.stop.schema.json",
  "title": "term.stop",
  "description": "Device to bridge (request): stop watching and end the grant (§16).",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "term.stop"
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "params": {
      "type": "object",
      "properties": {
        "grant": {
          "type": "string",
          "pattern": "^tg-[0-9a-f]{32}$"
        }
      },
      "required": [
        "grant"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "id",
    "params"
  ]
}
