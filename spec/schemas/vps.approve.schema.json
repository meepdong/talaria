{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/vps.approve.schema.json",
  "title": "vps.approve",
  "description": "Device to bridge (request): answer a pending VPS approval request (\u00a715).",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "vps.approve"
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "params": {
      "type": "object",
      "properties": {
        "approval_id": {
          "type": "string",
          "pattern": "^vps-[0-9a-f]{16}$"
        },
        "choice": {
          "enum": [
            "once",
            "session",
            "deny"
          ]
        }
      },
      "required": [
        "approval_id",
        "choice"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "id",
    "params"
  ]
}
