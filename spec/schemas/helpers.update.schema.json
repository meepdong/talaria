{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/helpers.update.schema.json",
  "title": "helpers.update",
  "description": "Bridge to device (notification): a bot's helper agents now (\u00a718.7).",
  "type": "object",
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "params"
  ],
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "helpers.update"
    },
    "params": {
      "type": "object",
      "properties": {
        "conversation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "helpers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "goal",
              "status",
              "tools",
              "can_steer"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "goal": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "tools": {
                "type": "integer",
                "minimum": 0
              },
              "last_tool": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "model": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "started_at": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "can_steer": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "required": [
        "conversation_id",
        "helpers"
      ],
      "additionalProperties": false
    }
  }
}
