{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/routines.set.schema.json",
  "title": "routines.set",
  "description": "Device to bridge (request): pause, resume, run or remove a routine (\u00a718.6).",
  "type": "object",
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "id",
    "params"
  ],
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "routines.set"
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "params": {
      "type": "object",
      "properties": {
        "bot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "routine_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "action": {
          "enum": [
            "pause",
            "resume",
            "run",
            "remove"
          ]
        }
      },
      "required": [
        "bot_id",
        "routine_id",
        "action"
      ],
      "additionalProperties": false
    }
  }
}
