{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/bots.describe.schema.json",
  "title": "bots.describe",
  "description": "Device to bridge (request): a bot's settings (\u00a718.8).",
  "type": "object",
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "id",
    "params"
  ],
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "bots.describe"
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "params": {
      "type": "object",
      "properties": {
        "bot_id": {
          "type": "string",
          "pattern": "^bot:[A-Za-z0-9][A-Za-z0-9_.-]{0,59}$"
        }
      },
      "required": [
        "bot_id"
      ],
      "additionalProperties": false
    }
  }
}
