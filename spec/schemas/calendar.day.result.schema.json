{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/calendar.day.result.schema.json",
  "title": "calendar.day.result",
  "description": "Result of calendar.day.",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "start": {
                "type": "string"
              },
              "end": {
                "type": "string"
              },
              "all_day": {
                "type": "boolean"
              },
              "location": {
                "type": "string"
              }
            },
            "required": [
              "title",
              "start",
              "end",
              "all_day"
            ]
          }
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "date",
        "events"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "id",
    "result"
  ]
}
