{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/rooms.approve.schema.json",
  "title": "rooms.approve",
  "description": "Device to bridge (request): answer an approval a room member asks for (\u00a718.2).",
  "type": "object",
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "id",
    "params"
  ],
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "rooms.approve"
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "params": {
      "type": "object",
      "properties": {
        "room_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "approval_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "choice": {
          "enum": [
            "once",
            "deny"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
