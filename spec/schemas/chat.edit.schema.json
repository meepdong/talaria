{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/chat.edit.schema.json",
  "title": "chat.edit",
  "description": "Device to bridge (request): rewind a bot's chat to before a message and send new text (\u00a718.10).",
  "type": "object",
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "id",
    "params"
  ],
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "chat.edit"
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "params": {
      "type": "object",
      "properties": {
        "conversation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "message_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32000
        }
      },
      "required": [
        "conversation_id",
        "message_id",
        "text"
      ],
      "additionalProperties": false
    }
  }
}
