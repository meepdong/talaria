{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/history.read.result.schema.json",
  "title": "history.read.result",
  "description": "Result of history.read (\u00a718.9).",
  "type": "object",
  "required": [
    "jsonrpc",
    "tnp",
    "id",
    "result"
  ],
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "text",
              "at"
            ],
            "properties": {
              "role": {
                "enum": [
                  "user",
                  "assistant"
                ]
              },
              "text": {
                "type": "string",
                "maxLength": 8000
              },
              "at": {
                "type": "integer"
              }
            }
          }
        },
        "has_more": {
          "type": "boolean"
        }
      },
      "required": [
        "messages",
        "has_more"
      ],
      "additionalProperties": false
    }
  }
}
