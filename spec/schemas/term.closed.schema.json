{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/term.closed.schema.json",
  "title": "term.closed",
  "description": "Bridge to the watching device (notification): the grant ended (§16).",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "term.closed"
    },
    "params": {
      "type": "object",
      "properties": {
        "grant": {
          "type": "string",
          "pattern": "^tg-[0-9a-f]{32}$"
        },
        "reason": {
          "type": "string",
          "maxLength": 300
        }
      },
      "required": [
        "grant",
        "reason"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "params"
  ]
}
