{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/error.schema.json",
  "title": "error",
  "description": "JSON-RPC error response. Codes in PROTOCOL \u00a713.",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "id": {
      "type": [
        "string",
        "integer",
        "null"
      ]
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "data": {}
      },
      "required": [
        "code",
        "message"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "id",
    "error"
  ]
}
