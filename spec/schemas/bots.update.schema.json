{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/bots.update.schema.json",
  "title": "bots.update",
  "description": "Device to bridge (request): change a bot (\u00a718.8).",
  "type": "object",
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "id",
    "params"
  ],
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "bots.update"
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "params": {
      "type": "object",
      "properties": {
        "bot_id": {
          "type": "string",
          "pattern": "^bot:[A-Za-z0-9][A-Za-z0-9_.-]{0,59}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "about": {
          "type": "string",
          "maxLength": 2000
        },
        "personality": {
          "type": "string",
          "maxLength": 40000
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "skills": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "toolsets": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "connectors": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "confirm": {
          "type": "boolean"
        }
      },
      "required": [
        "bot_id"
      ],
      "additionalProperties": false
    }
  }
}
