{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/blob.put.schema.json",
  "title": "blob.put",
  "description": "Device to bridge (request): the next chunk of an upload, base64 of at most chunk_bytes bytes.",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "blob.put"
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "params": {
      "type": "object",
      "properties": {
        "blob_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "data": {
          "type": "string",
          "minLength": 1,
          "maxLength": 699052
        }
      },
      "required": [
        "blob_id",
        "offset",
        "data"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "id",
    "params"
  ]
