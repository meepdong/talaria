{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/talk.turn.result.schema.json",
  "title": "talk.turn.result",
  "description": "Result of talk.turn and talk.say: the answer streams as talk.audio, talk.text and talk.done.",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "talk_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "talk_id"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "id",
    "result"
  ]
}
