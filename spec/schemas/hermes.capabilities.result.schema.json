{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/hermes.capabilities.result.schema.json",
  "title": "hermes.capabilities.result",
  "description": "Result of hermes.capabilities (\u00a718).",
  "type": "object",
  "required": [
    "jsonrpc",
    "tnp",
    "id",
    "result"
  ],
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "connected": {
          "type": "boolean"
        },
        "version": {
          "type": "string",
          "maxLength": 100
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "maxItems": 500
        },
        "server_requests": {
          "type": "array",
          "items": {
            "enum": [
              "approval",
              "clarify"
            ]
          }
        },
        "open_requests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "request_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "method": {
                "enum": [
                  "approval",
                  "clarify"
                ]
              },
              "params": {
                "type": "object"
              }
            },
            "required": [
              "request_id",
              "method",
              "params"
            ],
            "additionalProperties": false
          },
          "maxItems": 200
        }
      },
      "required": [
        "connected",
        "methods",
        "server_requests",
        "open_requests"
      ],
      "additionalProperties": false
    }
  }
}
