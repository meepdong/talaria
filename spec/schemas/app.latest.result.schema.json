{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/app.latest.result.schema.json",
  "title": "app.latest.result",
  "description": "Result of app.latest: release is missing when the channel has none yet.",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "channel": {
          "enum": [
            "beta",
            "stable"
          ]
        },
        "release": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-beta\\.[0-9]+)?$"
            },
            "version_code": {
              "type": "integer",
              "minimum": 1
            },
            "size": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "notes": {
              "type": "string",
              "maxLength": 4000
            },
            "published_at": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "version",
            "version_code",
            "size",
            "sha256",
            "published_at"
          ]
        }
      },
      "required": [
        "channel"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "id",
    "result"
  ]
}
