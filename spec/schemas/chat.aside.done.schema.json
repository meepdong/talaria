{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/chat.aside.done.schema.json",
  "title": "chat.aside.done",
  "description": "Bridge to every device (notification): the answer to a side question (\u00a711).",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "chat.aside.done"
    },
    "params": {
      "type": "object",
      "properties": {
        "conversation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "aside_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "question": {
          "type": "string",
          "maxLength": 4000
        },
        "status": {
          "enum": [
            "completed",
            "failed"
          ]
        },
        "text": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "conversation_id",
        "aside_id",
        "question",
        "status",
        "text"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "params"
  ]
}
