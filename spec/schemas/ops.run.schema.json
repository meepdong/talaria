{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/ops.run.schema.json",
  "title": "ops.run",
  "description": "Device to bridge (request): run a server operation. Tier 0 runs at once; tier 1-2 become an approval request on every device (\u00a710.8).",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "ops.run"
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "params": {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "pattern": "^[a-z]+(\\.[a-z_]+)+$",
          "maxLength": 64
        },
        "params": {
          "type": "object"
        }
      },
      "required": [
        "op"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "id",
    "params"
  ]
}
