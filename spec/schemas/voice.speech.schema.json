{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/voice.speech.schema.json",
  "title": "voice.speech",
  "description": "Device to bridge (request): one short piece of Talk's reply as natural speech (§9).",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "voice.speech"
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "params": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "voice": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "text"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "id",
    "params"
  ]
}
