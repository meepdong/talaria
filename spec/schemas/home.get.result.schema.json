{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/home.get.result.schema.json",
  "title": "home.get.result",
  "description": "Result of home.get.",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "run": {
                "type": "object",
                "properties": {
                  "at": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "status": {
                    "enum": [
                      "ok",
                      "error",
                      "nothing",
                      "blocked"
                    ]
                  },
                  "text": {
                    "type": "string"
                  },
                  "error": {
                    "type": "string"
                  },
                  "blocked": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "conversation_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  }
                },
                "required": [
                  "at",
                  "status"
                ]
              }
            },
            "required": [
              "id",
              "name",
              "run"
            ]
          }
        }
      },
      "required": [
        "date",
        "results"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "id",
    "result"
  ]
}
