{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/hello.schema.json",
  "title": "hello",
  "description": "Bridge to device, first frame on every connection (notification).",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "hello"
    },
    "params": {
      "type": "object",
      "properties": {
        "bridge_id": {
          "type": "string",
          "pattern": "^[A-Z2-7]{26}$"
        },
        "bridge_pk": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "nonce_b": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22}$",
          "description": "16 random bytes, base64url"
        },
        "ts": {
          "type": "integer",
          "minimum": 0
        },
        "sig_b": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "required": [
        "bridge_id",
        "bridge_pk",
        "nonce_b",
        "ts",
        "sig_b"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "params"
  ]
}
