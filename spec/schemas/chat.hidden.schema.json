{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/chat.hidden.schema.json",
  "title": "chat.hidden",
  "description": "Bridge to every device (notification): messages were hidden (\u00a79).",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "chat.hidden"
    },
    "params": {
      "type": "object",
      "properties": {
        "conversation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "message_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      },
      "required": [
        "conversation_id",
        "message_ids"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "params"
  ]
}
