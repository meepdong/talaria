{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/voice.speech.result.schema.json",
  "title": "voice.speech.result",
  "description": "Result of voice.speech: WAV (24 kHz 16-bit mono) or MP3 audio, base64.",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "format": {
          "enum": [
            "mp3",
            "wav"
          ]
        },
        "audio": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "format",
        "audio"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "id",
    "result"
  ]
}
