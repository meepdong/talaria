{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/chat.turn.get.result.schema.json",
  "title": "chat.turn.get.result",
  "description": "Result of chat.turn.get: a snapshot; later deltas have seq above it.",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "turn": {
          "type": "object",
          "properties": {
            "conversation_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "turn_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "seq": {
              "type": "integer",
              "minimum": 0
            },
            "status": {
              "enum": [
                "queued",
                "running",
                "completed",
                "failed",
                "cancelled"
              ]
            },
            "user_text": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "state": {
                    "enum": [
                      "started",
                      "completed",
                      "failed"
                    ]
                  },
                  "preview": {
                    "type": "string",
                    "maxLength": 500
                  }
                },
                "required": [
                  "name",
                  "state"
                ]
              }
            },
            "commentary": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "waiting_for_approval": {
              "type": "boolean"
            },
            "error": {
              "type": "string"
            },
            "usage": {
              "type": "object",
              "properties": {
                "input_tokens": {
                  "type": "integer",
                  "minimum": 0
                },
                "output_tokens": {
                  "type": "integer",
                  "minimum": 0
                },
                "total_tokens": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "runtime": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string"
                },
                "model": {
                  "type": "string"
                }
              }
            },
            "started_at": {
              "type": "integer"
            },
            "attachments": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "image",
                      "file"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 255
                  },
                  "mime": {
                    "type": "string",
                    "maxLength": 255
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "root": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "required": [
                  "kind",
                  "name",
                  "mime"
                ]
              },
              "maxItems": 128
            },
            "approval": {
              "type": "object",
              "description": "The pending approval (§9): what the agent wants to run and the answers it accepts.",
              "properties": {
                "choices": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "enum": [
                      "once",
                      "session",
                      "always",
                      "deny"
                    ]
                  }
                },
                "command": {
                  "type": "string",
                  "maxLength": 500
                },
                "description": {
                  "type": "string",
                  "maxLength": 500
                },
                "request_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "required": [
                "choices"
              ]
            }
          },
          "required": [
            "conversation_id",
            "turn_id",
            "seq",
            "status",
            "user_text",
            "text",
            "tools",
            "started_at"
          ]
        }
      },
      "required": [
        "turn"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "id",
    "result"
  ]
}
