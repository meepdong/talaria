{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/history.list.result.schema.json",
  "title": "history.list.result",
  "description": "Result of history.list (\u00a718.9).",
  "type": "object",
  "required": [
    "jsonrpc",
    "tnp",
    "id",
    "result"
  ],
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "sessions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "session_id",
              "title",
              "source",
              "started_at",
              "messages"
            ],
            "properties": {
              "session_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "title": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "started_at": {
                "type": "integer"
              },
              "last_active": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "messages": {
                "type": "integer",
                "minimum": 0
              },
              "snippet": {
                "type": "string"
              },
              "conversation_id": {
                "type": "string"
              }
            }
          }
        },
        "has_more": {
          "type": "boolean"
        }
      },
      "required": [
        "sessions",
        "has_more"
      ],
      "additionalProperties": false
    }
  }
}
