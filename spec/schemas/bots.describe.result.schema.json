{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/bots.describe.result.schema.json",
  "title": "bots.describe.result",
  "description": "Result of bots.describe (\u00a718.8).",
  "type": "object",
  "required": [
    "jsonrpc",
    "tnp",
    "id",
    "result"
  ],
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "bot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bot_id",
            "name",
            "about",
            "personality",
            "skills",
            "toolsets",
            "connectors"
          ],
          "properties": {
            "bot_id": {
              "type": "string",
              "pattern": "^bot:[A-Za-z0-9][A-Za-z0-9_.-]{0,59}$"
            },
            "name": {
              "type": "string"
            },
            "about": {
              "type": "string"
            },
            "personality": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "skills": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "enabled"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "enabled": {
                    "type": "boolean"
                  }
                }
              }
            },
            "toolsets": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "enabled"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "label": {
                    "type": "string"
                  },
                  "about": {
                    "type": "string"
                  }
                }
              }
            },
            "connectors": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "enabled"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "enabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      },
      "required": [
        "bot"
      ],
      "additionalProperties": false
    }
  }
}
