{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/bots.list.result.schema.json",
  "title": "bots.list.result",
  "description": "Result of bots.list (\u00a718.1).",
  "type": "object",
  "required": [
    "jsonrpc",
    "tnp",
    "id",
    "result"
  ],
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "bots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^bot:[A-Za-z0-9][A-Za-z0-9_.-]{0,59}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "profile": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "has_avatar": {
                "type": "boolean"
              },
              "description": {
                "type": "string",
                "maxLength": 500
              },
              "role": {
                "type": "string",
                "maxLength": 500
              },
              "model": {
                "type": "string",
                "maxLength": 500
              }
            },
            "required": [
              "id",
              "name",
              "profile",
              "has_avatar"
            ],
            "additionalProperties": false
          },
          "maxItems": 500
        },
        "available": {
          "type": "boolean"
        }
      },
      "required": [
        "bots",
        "available"
      ],
      "additionalProperties": false
    }
  }
}
