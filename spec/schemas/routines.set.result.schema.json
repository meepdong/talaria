{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/routines.set.result.schema.json",
  "title": "routines.set.result",
  "description": "Result of routines.set (\u00a718.6).",
  "type": "object",
  "required": [
    "jsonrpc",
    "tnp",
    "id",
    "result"
  ],
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "routine": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "bot_id",
            "name",
            "schedule",
            "task",
            "enabled",
            "state",
            "to_chat"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "bot_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "name": {
              "type": "string"
            },
            "schedule": {
              "type": "string"
            },
            "task": {
              "type": "string",
              "maxLength": 2000
            },
            "enabled": {
              "type": "boolean"
            },
            "state": {
              "type": "string"
            },
            "next_run_at": {
              "type": [
                "integer",
                "null"
              ]
            },
            "last_run_at": {
              "type": [
                "integer",
                "null"
              ]
            },
            "last_status": {
              "enum": [
                "ok",
                "error",
                null
              ]
            },
            "last_error": {
              "type": [
                "string",
                "null"
              ]
            },
            "to_chat": {
              "type": "boolean"
            }
          }
        }
      },
      "required": [],
      "additionalProperties": false
    }
  }
}
