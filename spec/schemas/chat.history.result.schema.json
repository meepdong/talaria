{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/chat.history.result.schema.json",
  "title": "chat.history.result",
  "description": "Result of chat.history. Messages are oldest first within the page.",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "role": {
                "enum": [
                  "user",
                  "assistant"
                ]
              },
              "text": {
                "type": "string"
              },
              "ts": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "tools": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "role",
              "text",
              "ts"
            ]
          }
        },
        "next_before": {
          "type": [
            "string",
            "null"
          ],
          "description": "Pass as `before` for the next older page; null when there is none."
        }
      },
      "required": [
        "messages",
        "next_before"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "id",
    "result"
  ]
}
