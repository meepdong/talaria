{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/term.keys.schema.json",
  "title": "term.keys",
  "description": "Device to bridge (request): type into the session of a control grant (§16).",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "term.keys"
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "params": {
      "type": "object",
      "properties": {
        "grant": {
          "type": "string",
          "pattern": "^tg-[0-9a-f]{32}$"
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                },
                "required": [
                  "text"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "key": {
                    "enum": [
                      "Enter",
                      "Escape",
                      "Tab",
                      "BTab",
                      "BSpace",
                      "Space",
                      "Up",
                      "Down",
                      "Left",
                      "Right",
                      "Home",
                      "End",
                      "PPage",
                      "NPage",
                      "C-c",
                      "C-d",
                      "C-z",
                      "C-l",
                      "C-r",
                      "C-o"
                    ]
                  }
                },
                "required": [
                  "key"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "grant",
        "keys"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "id",
    "params"
  ]
}
