{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/blob.put.result.schema.json",
  "title": "blob.put.result",
  "description": "Result of blob.put: bytes received so far.",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "blob_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "received": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "blob_id",
        "received"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "id",
    "result"
  ]
}
