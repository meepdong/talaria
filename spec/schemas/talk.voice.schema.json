{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/talk.voice.schema.json",
  "title": "talk.voice",
  "description": "Device to bridge: the talker speaks in this voice from now on, on every device (\u00a79).",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "talk.voice"
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "params": {
      "type": "object",
      "properties": {
        "voice": {
          "enum": [
            "shimmer",
            "marin",
            "cedar",
            "coral",
            "sage",
            "alloy",
            "ballad",
            "verse",
            "ash",
            "echo",
            "fable",
            "nova",
            "onyx"
          ]
        }
      },
      "required": [
        "voice"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "id",
    "params"
  ]
}
