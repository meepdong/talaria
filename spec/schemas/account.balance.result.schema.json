{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/account.balance.result.schema.json",
  "title": "account.balance.result",
  "description": "Result of account.balance. Provider keys stay on the bridge.",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "accounts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "name": {
                "type": "string"
              },
              "remaining": {
                "type": "number"
              },
              "currency": {
                "type": "string",
                "minLength": 3,
                "maxLength": 3
              },
              "top_up_url": {
                "type": "string",
                "pattern": "^https://"
              },
              "error": {
                "type": "string"
              }
            },
            "required": [
              "provider",
              "name",
              "top_up_url"
            ]
          }
        }
      },
      "required": [
        "accounts"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "id",
    "result"
  ]
}
