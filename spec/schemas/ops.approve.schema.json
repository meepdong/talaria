{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/ops.approve.schema.json",
  "title": "ops.approve",
  "description": "Device to bridge (request): answer an approval with a signature over frame(\"tnp0-ops-approve\", request_id, device_id, op, params_json, choice).",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "ops.approve"
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "params": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^(op|hc)-[0-9a-f]{16}$"
        },
        "choice": {
          "enum": [
            "once",
            "deny"
          ]
        },
        "sig": {
          "type": "string",
          "minLength": 16,
          "maxLength": 200
        }
      },
      "required": [
        "request_id",
        "choice",
        "sig"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "id",
    "params"
  ]
}
