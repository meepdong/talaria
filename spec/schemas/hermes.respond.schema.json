{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/hermes.respond.schema.json",
  "title": "hermes.respond",
  "description": "Device to bridge (request): answer a question Hermes asked (approval or clarify) (\u00a718).",
  "type": "object",
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "id",
    "params"
  ],
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "hermes.respond"
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "params": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "result": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "required": [
        "request_id",
        "result"
      ]
    }
  }
}
