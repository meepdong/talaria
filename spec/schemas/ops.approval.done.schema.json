{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/ops.approval.done.schema.json",
  "title": "ops.approval.done",
  "description": "Bridge to every device (notification): an approval is settled; close its card. 'expired' means nobody answered in time.",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "ops.approval.done"
    },
    "params": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^(op|hc)-[0-9a-f]{16}$"
        },
        "choice": {
          "enum": [
            "once",
            "deny",
            "expired"
          ]
        }
      },
      "required": [
        "request_id",
        "choice"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "params"
  ]
}
