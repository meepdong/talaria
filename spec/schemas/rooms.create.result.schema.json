{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/rooms.create.result.schema.json",
  "title": "rooms.create.result",
  "description": "Result of rooms.create (\u00a718.2).",
  "type": "object",
  "required": [
    "jsonrpc",
    "tnp",
    "id",
    "result"
  ],
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "room": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "members": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "member_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "handle": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "bot_id": {
                    "type": "string",
                    "pattern": "^bot:[A-Za-z0-9][A-Za-z0-9_.-]{0,59}$"
                  }
                },
                "required": [
                  "member_id",
                  "name",
                  "handle"
                ],
                "additionalProperties": false
              },
              "maxItems": 6
            },
            "updated_at": {
              "type": "integer",
              "minimum": 0
            },
            "working": {
              "type": "boolean"
            },
            "needs_you": {
              "type": "boolean"
            },
            "preview": {
              "type": "object",
              "properties": {
                "speaker": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "text": {
                  "type": "string",
                  "maxLength": 300
                }
              },
              "required": [
                "speaker",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "name",
            "members",
            "updated_at",
            "working",
            "needs_you"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "room"
      ],
      "additionalProperties": false
    }
  }
}
