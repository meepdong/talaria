{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/conversations.list.result.schema.json",
  "title": "conversations.list.result",
  "description": "Result of conversations.list.",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "conversations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "conversation_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "agent_id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "created_at": {
                "type": "integer"
              },
              "updated_at": {
                "type": "integer"
              },
              "last_message": {
                "type": "object",
                "properties": {
                  "role": {
                    "enum": [
                      "user",
                      "assistant"
                    ]
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 200
                  }
                },
                "required": [
                  "role",
                  "text"
                ]
              },
              "active_turn_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "model": {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "provider",
                  "model"
                ]
              },
              "queued_turn_ids": {
                "type": "array",
                "maxItems": 5,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              },
              "pinned": {
                "type": "boolean"
              }
            },
            "required": [
              "conversation_id",
              "agent_id",
              "title",
              "created_at",
              "updated_at"
            ]
          }
        }
      },
      "required": [
        "conversations"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "id",
    "result"
  ]
}
