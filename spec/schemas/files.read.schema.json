{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/files.read.schema.json",
  "title": "files.read",
  "description": "Device to bridge (request): one chunk of a server file (§12).",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "files.read"
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "params": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "path": {
          "type": "string",
          "maxLength": 4096
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "root",
        "path"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "id",
    "params"
  ]
}
