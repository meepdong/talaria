{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/talk.done.schema.json",
  "title": "talk.done",
  "description": "Bridge to devices: the talker has finished; conversation_id is the chat it worked in, unprompted marks the agent's reply spoken on its own (§9).",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "talk.done"
    },
    "params": {
      "type": "object",
      "properties": {
        "talk_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "text": {
          "type": "string"
        },
        "conversation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "unprompted": {
          "type": "boolean"
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "talk_id",
        "text"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "params"
  ]
}
