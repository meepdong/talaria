{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/usage.get.result.schema.json",
  "title": "usage.get.result",
  "description": "Result of usage.get (\u00a718.5).",
  "type": "object",
  "required": [
    "jsonrpc",
    "tnp",
    "id",
    "result"
  ],
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "days": {
          "type": "integer"
        },
        "total": {
          "type": "object",
          "properties": {
            "cost_usd": {
              "type": "number",
              "minimum": 0
            },
            "estimated": {
              "type": "boolean"
            },
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "sessions": {
              "type": "integer",
              "minimum": 0
            },
            "calls": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "cost_usd",
            "estimated",
            "input_tokens",
            "output_tokens",
            "sessions",
            "calls"
          ],
          "additionalProperties": false
        },
        "by_day": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "day": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "cost_usd": {
                "type": "number",
                "minimum": 0
              },
              "estimated": {
                "type": "boolean"
              },
              "input_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "output_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "sessions": {
                "type": "integer",
                "minimum": 0
              },
              "calls": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "day",
              "cost_usd",
              "estimated",
              "input_tokens",
              "output_tokens",
              "sessions",
              "calls"
            ],
            "additionalProperties": false
          }
        },
        "by_model": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "model": {
                "type": "string"
              },
              "cost_usd": {
                "type": "number",
                "minimum": 0
              },
              "estimated": {
                "type": "boolean"
              },
              "input_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "output_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "sessions": {
                "type": "integer",
                "minimum": 0
              },
              "calls": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "model",
              "cost_usd",
              "estimated",
              "input_tokens",
              "output_tokens",
              "sessions",
              "calls"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "days",
        "total",
        "by_day",
        "by_model"
      ],
      "additionalProperties": false
    }
  }
}
