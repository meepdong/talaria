{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/ops.approve.result.schema.json",
  "title": "ops.approve.result",
  "description": "Bridge to device (result of ops.approve).",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^op-[0-9a-f]{16}$"
        },
        "choice": {
          "enum": [
            "once",
            "deny"
          ]
        }
      },
      "required": [
        "request_id",
        "choice"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "id",
    "result"
  ]
}
