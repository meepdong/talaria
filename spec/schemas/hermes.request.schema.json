{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/hermes.request.schema.json",
  "title": "hermes.request",
  "description": "Bridge to every device (notification): Hermes asks something (approval or clarify) (\u00a718).",
  "type": "object",
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "params"
  ],
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "hermes.request"
    },
    "params": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "method": {
          "enum": [
            "approval",
            "clarify"
          ]
        },
        "params": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "required": [
        "request_id",
        "method",
        "params"
      ]
    }
  }
}
