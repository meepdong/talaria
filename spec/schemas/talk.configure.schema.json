{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/talk.configure.schema.json",
  "title": "talk.configure",
  "description": "Device to bridge (request): change Tally's main model, voice model or voice (\u00a79).",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "talk.configure"
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "params": {
      "type": "object",
      "properties": {
        "brain": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "speech": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "voice": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "id"
  ]
}
