{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/automations.ran.schema.json",
  "title": "automations.ran",
  "description": "Bridge to every device (notification): an automation finished a run with a result (§14).",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "automations.ran"
    },
    "params": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "result_to": {
          "enum": [
            "home",
            "chat",
            "log"
          ]
        },
        "run": {
          "type": "object",
          "properties": {
            "at": {
              "type": "integer",
              "minimum": 0
            },
            "status": {
              "enum": [
                "ok",
                "error",
                "nothing",
                "blocked"
              ]
            },
            "text": {
              "type": "string"
            },
            "error": {
              "type": "string"
            },
            "blocked": {
              "type": "string",
              "maxLength": 500
            },
            "conversation_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": [
            "at",
            "status"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "result_to",
        "run"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "params"
  ]
}
