{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/files.list.result.schema.json",
  "title": "files.list.result",
  "description": "Result of files.list.",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "path": {
          "type": "string",
          "maxLength": 4096
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "path": {
                "type": "string",
                "maxLength": 4096
              },
              "kind": {
                "enum": [
                  "file",
                  "folder"
                ]
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "mime": {
                "type": "string"
              },
              "modified": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "name",
              "path",
              "kind",
              "modified"
            ]
          },
          "maxItems": 500
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "root",
        "path",
        "entries",
        "truncated"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "id",
    "result"
  ]
}
