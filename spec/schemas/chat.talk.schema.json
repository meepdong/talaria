{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/chat.talk.schema.json",
  "title": "chat.talk",
  "description": "Bridge to every device (notification): a spoken exchange from Talk, kept in a conversation (\u00a79).",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "chat.talk"
    },
    "params": {
      "type": "object",
      "properties": {
        "conversation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "message": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^t-[0-9]+$"
            },
            "role": {
              "enum": [
                "user",
                "assistant"
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "ts": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "id",
            "role",
            "text",
            "ts"
          ]
        }
      },
      "required": [
        "conversation_id",
        "message"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "params"
  ]
}
