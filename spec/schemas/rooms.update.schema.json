{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/rooms.update.schema.json",
  "title": "rooms.update",
  "description": "Bridge to every device (notification): what's new in one room (\u00a718.2).",
  "type": "object",
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "params"
  ],
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "rooms.update"
    },
    "params": {
      "type": "object",
      "properties": {
        "room_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "seq": {
                "type": "integer",
                "minimum": 0
              },
              "at": {
                "type": "integer",
                "minimum": 0
              },
              "kind": {
                "enum": [
                  "user",
                  "member",
                  "note"
                ]
              },
              "speaker": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "text": {
                "type": "string",
                "maxLength": 40000
              },
              "thread_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "member_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "required": [
              "seq",
              "at",
              "kind",
              "speaker",
              "text"
            ],
            "additionalProperties": false
          },
          "maxItems": 500
        },
        "working": {
          "type": "boolean"
        },
        "approvals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "approval_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "member": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "command": {
                "type": "string",
                "maxLength": 2000
              },
              "description": {
                "type": "string",
                "maxLength": 2000
              },
              "choices": {
                "type": "array",
                "items": {
                  "enum": [
                    "once",
                    "deny"
                  ]
                }
              }
            },
            "required": [
              "approval_id",
              "member",
              "choices"
            ],
            "additionalProperties": false
          },
          "maxItems": 20
        },
        "needs_you": {
          "type": "boolean"
        },
        "stuck": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
