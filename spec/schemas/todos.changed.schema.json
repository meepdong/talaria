{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/todos.changed.schema.json",
  "title": "todos.changed",
  "description": "Bridge to every device (notification): the whole to-do list after a change (§13).",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "todos.changed"
    },
    "params": {
      "type": "object",
      "properties": {
        "todos": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "done": {
                "type": "boolean"
              },
              "created_at": {
                "type": "integer",
                "minimum": 0
              },
              "done_at": {
                "type": "integer",
                "minimum": 0
              },
              "due": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "conversation_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "group": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "comments": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "by": {
                      "enum": [
                        "you",
                        "agent"
                      ]
                    },
                    "at": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "id",
                    "text",
                    "by",
                    "at"
                  ]
                }
              }
            },
            "required": [
              "id",
              "text",
              "done",
              "created_at"
            ]
          }
        }
      },
      "required": [
        "todos"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "params"
  ]
}
