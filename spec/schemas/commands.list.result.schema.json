{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/commands.list.result.schema.json",
  "title": "commands.list.result",
  "description": "Result of commands.list (\u00a718.3).",
  "type": "object",
  "required": [
    "jsonrpc",
    "tnp",
    "id",
    "result"
  ],
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "maxItems": 400,
          "items": {
            "type": "object",
            "required": [
              "name",
              "about",
              "category",
              "approve"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_:.-]{0,63}$"
              },
              "about": {
                "type": "string",
                "maxLength": 300
              },
              "category": {
                "type": "string",
                "maxLength": 60
              },
              "approve": {
                "type": "boolean"
              }
            }
          }
        },
        "available": {
          "type": "boolean"
        }
      },
      "required": [
        "commands",
        "available"
      ],
      "additionalProperties": false
    }
  }
}
