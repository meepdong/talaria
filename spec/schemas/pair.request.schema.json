{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/pair.request.schema.json",
  "title": "pair.request",
  "description": "Device to bridge, instead of auth when pairing (notification). Exactly one of pair_token or short_code.",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "pair.request"
    },
    "params": {
      "type": "object",
      "properties": {
        "device_pk": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "ts": {
          "type": "integer",
          "minimum": 0
        },
        "sig_d": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "pair_token": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "short_code": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{8}$"
        }
      },
      "required": [
        "device_pk",
        "name",
        "platform",
        "ts",
        "sig_d"
      ],
      "oneOf": [
        {
          "required": [
            "pair_token"
          ]
        },
        {
          "required": [
            "short_code"
          ]
        }
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "params"
  ]
}
