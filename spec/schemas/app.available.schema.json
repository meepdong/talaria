{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/app.available.schema.json",
  "title": "app.available",
  "description": "Bridge to every device (notification): a new release is ready on this bridge's channel (§17).",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "app.available"
    },
    "params": {
      "type": "object",
      "properties": {
        "platform": {
          "enum": [
            "android"
          ]
        },
        "channel": {
          "enum": [
            "beta",
            "stable"
          ]
        },
        "release": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-beta\\.[0-9]+)?$"
            },
            "version_code": {
              "type": "integer",
              "minimum": 1
            },
            "size": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "notes": {
              "type": "string",
              "maxLength": 4000
            },
            "published_at": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "version",
            "version_code",
            "size",
            "sha256",
            "published_at"
          ]
        }
      },
      "required": [
        "platform",
        "channel",
        "release"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "params"
  ]
}
