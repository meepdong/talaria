{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/automations.changed.schema.json",
  "title": "automations.changed",
  "description": "Bridge to every device (notification): the automation list after a change (§14).",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "automations.changed"
    },
    "params": {
      "type": "object",
      "properties": {
        "automations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "when": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "time"
                      },
                      "schedule": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      }
                    },
                    "required": [
                      "kind",
                      "schedule"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "arrives"
                      },
                      "watch": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      },
                      "from": {
                        "type": "string",
                        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                      },
                      "until": {
                        "type": "string",
                        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                      },
                      "days": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 7,
                        "uniqueItems": true,
                        "items": {
                          "enum": [
                            "mon",
                            "tue",
                            "wed",
                            "thu",
                            "fri",
                            "sat",
                            "sun"
                          ]
                        }
                      },
                      "fallback": {
                        "type": "string",
                        "maxLength": 2000
                      }
                    },
                    "required": [
                      "kind",
                      "watch",
                      "from",
                      "until",
                      "days"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "after_event"
                      },
                      "event": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "delay_minutes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 240
                      },
                      "days": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 7,
                        "uniqueItems": true,
                        "items": {
                          "enum": [
                            "mon",
                            "tue",
                            "wed",
                            "thu",
                            "fri",
                            "sat",
                            "sun"
                          ]
                        }
                      }
                    },
                    "required": [
                      "kind",
                      "event",
                      "delay_minutes",
                      "days"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "other"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  }
                ]
              },
              "task": {
                "type": "string",
                "maxLength": 5000
              },
              "result_to": {
                "enum": [
                  "home",
                  "chat",
                  "log"
                ]
              },
              "made_in": {
                "enum": [
                  "talaria",
                  "agent"
                ]
              },
              "state": {
                "enum": [
                  "scheduled",
                  "paused",
                  "running",
                  "completed",
                  "error"
                ]
              },
              "next_run_at": {
                "type": "integer",
                "minimum": 0
              },
              "last_run_at": {
                "type": "integer",
                "minimum": 0
              },
              "last_status": {
                "enum": [
                  "ok",
                  "error",
                  "nothing"
                ]
              },
              "last_error": {
                "type": "string"
              },
              "schedule_text": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "when",
              "task",
              "result_to",
              "made_in",
              "state",
              "schedule_text"
            ]
          }
        }
      },
      "required": [
        "automations"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "params"
  ]
}
