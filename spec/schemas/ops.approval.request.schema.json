{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/ops.approval.request.schema.json",
  "title": "ops.approval.request",
  "description": "Bridge to every device (notification): a server operation waits for approval. Re-sent to a device whose session becomes ready while it is still pending.",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "ops.approval.request"
    },
    "params": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^(op|hc)-[0-9a-f]{16}$"
        },
        "op": {
          "type": "string",
          "pattern": "^[a-z]+(\\.[a-z_]+)+$",
          "maxLength": 64
        },
        "params_json": {
          "type": "string",
          "maxLength": 4096,
          "description": "The exact string to sign; show what it parses to."
        },
        "tier": {
          "enum": [
            1,
            2
          ]
        },
        "summary": {
          "type": "string",
          "maxLength": 500
        },
        "requested_by": {
          "type": "string",
          "maxLength": 128,
          "description": "agent:<id> or device:<device_id>"
        },
        "expires_at": {
          "type": "integer"
        }
      },
      "required": [
        "request_id",
        "op",
        "params_json",
        "tier",
        "summary",
        "requested_by",
        "expires_at"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "params"
  ]
}
