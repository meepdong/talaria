{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/talk.heard.schema.json",
  "title": "talk.heard",
  "description": "Bridge to devices: what the owner said in a talk.turn, as words (\u00a79); conversation_id is where it's kept.",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "talk.heard"
    },
    "params": {
      "type": "object",
      "properties": {
        "talk_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "text": {
          "type": "string"
        },
        "conversation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "talk_id",
        "text",
        "conversation_id"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "params"
  ]
}
