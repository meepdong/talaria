{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/hermes.request.done.schema.json",
  "title": "hermes.request.done",
  "description": "Bridge to every device (notification): a question from Hermes is closed (\u00a718).",
  "type": "object",
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "params"
  ],
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "hermes.request.done"
    },
    "params": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reason": {
          "enum": [
            "answered",
            "withdrawn",
            "disconnected"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "request_id",
        "reason"
      ]
    }
  }
}
