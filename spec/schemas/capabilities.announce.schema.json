{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/capabilities.announce.schema.json",
  "title": "capabilities.announce",
  "description": "Device to bridge after auth.ok and on every change (notification). Capability entries are defined in PROTOCOL \u00a75.1.",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "capabilities.announce"
    },
    "params": {
      "type": "object",
      "properties": {
        "device": {
          "type": "object"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "v": {
                "type": "integer"
              },
              "tier": {
                "enum": [
                  0,
                  1,
                  2
                ]
              },
              "constraints": {
                "type": "object"
              }
            },
            "required": [
              "name",
              "v",
              "tier"
            ]
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relayed": {
          "type": "array"
        }
      },
      "required": [
        "device",
        "capabilities"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "params"
  ]
}
