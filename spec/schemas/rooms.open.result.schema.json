{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/rooms.open.result.schema.json",
  "title": "rooms.open.result",
  "description": "Result of rooms.open (\u00a718.2).",
  "type": "object",
  "required": [
    "jsonrpc",
    "tnp",
    "id",
    "result"
  ],
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "room": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "members": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "member_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "handle": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "bot_id": {
                    "type": "string",
                    "pattern": "^bot:[A-Za-z0-9][A-Za-z0-9_.-]{0,59}$"
                  }
                },
                "required": [
                  "member_id",
                  "name",
                  "handle"
                ],
                "additionalProperties": false
              },
              "maxItems": 6
            },
            "updated_at": {
              "type": "integer",
              "minimum": 0
            },
            "working": {
              "type": "boolean"
            },
            "needs_you": {
              "type": "boolean"
            },
            "preview": {
              "type": "object",
              "properties": {
                "speaker": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "text": {
                  "type": "string",
                  "maxLength": 300
                }
              },
              "required": [
                "speaker",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "name",
            "members",
            "updated_at",
            "working",
            "needs_you"
          ],
          "additionalProperties": false
        },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "seq": {
                "type": "integer",
                "minimum": 0
              },
              "at": {
                "type": "integer",
                "minimum": 0
              },
              "kind": {
                "enum": [
                  "user",
                  "member",
                  "note"
                ]
              },
              "speaker": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "text": {
                "type": "string",
                "maxLength": 40000
              },
              "thread_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "member_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "required": [
              "seq",
              "at",
              "kind",
              "speaker",
              "text"
            ],
            "additionalProperties": false
          },
          "maxItems": 500
        },
        "has_more": {
          "type": "boolean"
        },
        "approvals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "approval_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "member": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "command": {
                "type": "string",
                "maxLength": 2000
              },
              "description": {
                "type": "string",
                "maxLength": 2000
              },
              "choices": {
                "type": "array",
                "items": {
                  "enum": [
                    "once",
                    "deny"
                  ]
                }
              }
            },
            "required": [
              "approval_id",
              "member",
              "choices"
            ],
            "additionalProperties": false
          },
          "maxItems": 20
        }
      },
      "required": [
        "room",
        "messages",
        "has_more",
        "approvals"
      ],
      "additionalProperties": false
    }
  }
}
