{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/chat.send.schema.json",
  "title": "chat.send",
  "description": "Device to bridge (request): send one message; the reply streams as chat.delta and chat.done (spec/README.md §9).",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "chat.send"
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "params": {
      "type": "object",
      "properties": {
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "conversation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "text": {
          "type": "string",
          "maxLength": 32000,
          "description": "May be empty when attachments are sent."
        },
        "client_msg_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Retry key: the same value within 10 minutes returns the original turn."
        },
        "attachments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "description": "Committed blobs (§10). Each blob can be sent once.",
          "items": {
            "type": "object",
            "properties": {
              "blob_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            },
            "required": [
              "blob_id"
            ]
          }
        },
        "model": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "provider",
            "model"
          ],
          "description": "Pin the conversation to this model before the turn (§11)."
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "root": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "path": {
                "type": "string",
                "maxLength": 4096
              }
            },
            "required": [
              "root",
              "path"
            ]
          },
          "minItems": 1,
          "maxItems": 128
        },
        "todo_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "text"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "id",
    "params"
  ]
}
