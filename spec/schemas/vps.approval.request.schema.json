{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/vps.approval.request.schema.json",
  "title": "vps.approval.request",
  "description": "Bridge to every device (notification): the agent asks to run an allowlisted command on the VPS (\u00a715). Also re-sent to a device when its session becomes ready while the request is still pending.",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "vps.approval.request"
    },
    "params": {
      "type": "object",
      "properties": {
        "approval_id": {
          "type": "string",
          "pattern": "^vps-[0-9a-f]{16}$"
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "args": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800
        },
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "expires_at": {
          "type": "integer",
          "description": "Unix seconds after which the bridge gives up waiting."
        }
      },
      "required": [
        "approval_id",
        "command",
        "args",
        "cwd",
        "timeout",
        "agent_id",
        "expires_at"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "params"
  ]
}
