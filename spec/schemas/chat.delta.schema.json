{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/chat.delta.schema.json",
  "title": "chat.delta",
  "description": "Bridge to every device (notification): streaming output of a running turn.",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "chat.delta"
    },
    "params": {
      "type": "object",
      "properties": {
        "conversation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "turn_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "text",
            "tool_progress",
            "commentary",
            "approval"
          ]
        },
        "text": {
          "type": "string"
        },
        "tool": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "state": {
              "enum": [
                "started",
                "completed",
                "failed"
              ]
            },
            "preview": {
              "type": "string",
              "maxLength": 500
            }
          },
          "required": [
            "name",
            "state"
          ]
        }
      },
      "required": [
        "conversation_id",
        "turn_id",
        "seq",
        "kind"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "params"
  ]
}
