{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/blob.commit.result.schema.json",
  "title": "blob.commit.result",
  "description": "Result of blob.commit: the blob can now be attached to chat.send.",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "blob_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "kind": {
          "enum": [
            "image",
            "file"
          ]
        },
        "name": {
          "type": "string"
        },
        "mime": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "blob_id",
        "kind",
        "name",
        "mime",
        "size"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "id",
    "result"
  ]
}
