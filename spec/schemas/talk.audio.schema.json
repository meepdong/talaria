{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/talk.audio.schema.json",
  "title": "talk.audio",
  "description": "Bridge to devices: the next piece of the talker's voice, 24 kHz 16-bit mono PCM, base64, in seq order (§9).",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "talk.audio"
    },
    "params": {
      "type": "object",
      "properties": {
        "talk_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "data": {
          "type": "string"
        },
        "conversation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "talk_id",
        "seq",
        "data"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "params"
  ]
}
