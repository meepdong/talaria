{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/automations.add.schema.json",
  "title": "automations.add",
  "description": "Device to bridge (request): a new automation (§14).",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "automations.add"
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "params": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "when": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "time"
                },
                "schedule": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              },
              "required": [
                "kind",
                "schedule"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "arrives"
                },
                "watch": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "from": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                },
                "until": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                },
                "days": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 7,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "mon",
                      "tue",
                      "wed",
                      "thu",
                      "fri",
                      "sat",
                      "sun"
                    ]
                  }
                },
                "fallback": {
                  "type": "string",
                  "maxLength": 2000
                }
              },
              "required": [
                "kind",
                "watch",
                "from",
                "until",
                "days"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "after_event"
                },
                "event": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "delay_minutes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 240
                },
                "days": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 7,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "mon",
                      "tue",
                      "wed",
                      "thu",
                      "fri",
                      "sat",
                      "sun"
                    ]
                  }
                }
              },
              "required": [
                "kind",
                "event",
                "delay_minutes",
                "days"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "other"
                }
              },
              "required": [
                "kind"
              ]
            }
          ]
        },
        "task": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "result_to": {
          "enum": [
            "home",
            "chat",
            "log"
          ]
        },
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "name",
        "when",
        "task"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "id",
    "params"
  ]
}
