{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/ops.catalogue.result.schema.json",
  "title": "ops.catalogue.result",
  "description": "Bridge to device (result of ops.catalogue).",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "ops": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "pattern": "^[a-z]+(\\.[a-z_]+)+$",
                "maxLength": 64
              },
              "tier": {
                "enum": [
                  0,
                  1,
                  2
                ]
              },
              "title": {
                "type": "string",
                "maxLength": 120
              },
              "params": {
                "type": "object",
                "description": "Parameter name -> {type: string|integer, enum?, minimum?, maximum?, default?}."
              }
            },
            "required": [
              "op",
              "tier",
              "title",
              "params"
            ]
          }
        }
      },
      "required": [
        "ops"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "id",
    "result"
  ]
}
