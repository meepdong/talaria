{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/chat.history.schema.json",
  "title": "chat.history",
  "description": "Device to bridge (request): one page of a conversation's messages, newest page first.",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "chat.history"
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "params": {
      "type": "object",
      "properties": {
        "conversation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "before": {
          "type": "string",
          "maxLength": 32
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "conversation_id"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "id",
    "params"
  ]
}
