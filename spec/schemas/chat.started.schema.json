{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talaria.invalid/tnp/v0/chat.started.schema.json",
  "title": "chat.started",
  "description": "Bridge to every device (notification): a turn started, from this device or another.",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "tnp": {
      "const": 0
    },
    "method": {
      "const": "chat.started"
    },
    "params": {
      "type": "object",
      "properties": {
        "conversation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "turn_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "agent_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "user_text": {
          "type": "string"
        },
        "started_at": {
          "type": "integer"
        }
      },
      "required": [
        "conversation_id",
        "turn_id",
        "agent_id",
        "title",
        "user_text",
        "started_at"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "tnp",
    "method",
    "params"
  ]
}
